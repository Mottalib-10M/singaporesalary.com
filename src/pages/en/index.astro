---
import { LANG_TAGS as __LT } from '../../data/site-config';
import { displayDate } from '../../lib/format';
import PageLayout from '../../layouts/PageLayout.astro';
import SgCalculator from '../../components/calc/SgCalculator';
import ContentTable from '../../components/ContentTable.astro';
import AdSlot from '../../components/AdSlot.astro';
import Sources from '../../components/Sources.astro';
import { YEAR, LAST_UPDATED, AUTHOR_NAME } from '../../data/site-config';
import { route, MONTHLY, ANNUAL, HOURLY } from '../../i18n/routes';
import { monthlyLabel, annualLabel, hourlyLabel, label } from '../../i18n/nav';
import { webApplicationSchema, faqSchema, breadcrumbSchema, organizationSchema, personSchema, websiteSchema } from '../../lib/seo';
import { ex, cpf, P } from '../../lib/tables';
import { formatMoney, formatPercent, formatDecimal } from '../../lib/format';
const lang = 'en';
const T = P.cpf.tables.SC.rates;
const title = `Salary Calculator Singapore ${YEAR}: CPF, Tax and Take-Home`;
const description = `Take-home pay, employee and employer CPF for citizens, PRs in their first two years and foreigners, plus IRAS income tax for YA 2027. Free, no sign-up.`;
const e5 = ex(5000); const pr1 = ex(5000, { status: 'SPR1_GG' }); const pr2 = ex(5000, { status: 'SPR2_GG' }); const fo = ex(5000, { status: 'FOREIGNER' });
const e58 = ex(5000, { age: 58 }); const e10 = ex(10000);
const rows = [2500, 3500, 5000, 6500, 8000, 10000, 15000].map((m) => { const r = ex(m); return [formatMoney(m), formatMoney(r.monthly.employee), formatMoney(r.takeHomeMonthly), formatMoney(r.monthly.employer), formatMoney(r.annual.tax), formatMoney(r.annual.net / 12)]; });
const statusRows = ([['SC', 'Citizen, or PR from year 3'], ['SPR2_GG', 'PR, 2nd year (G/G)'], ['SPR1_GG', 'PR, 1st year (G/G)'], ['SPR2_FG', 'PR, 2nd year (F/G)'], ['SPR1_FG', 'PR, 1st year (F/G)'], ['FOREIGNER', 'Employment Pass, S Pass']] as const).map(([s, l]) => { const c = cpf(5000, 30, s); return [l, formatMoney(c.employee), formatMoney(c.employer), formatMoney(5000 - c.employee)]; });
const faqs = [
  { q: 'How much CPF is deducted from my salary in 2026?', a: `If you are a Singapore Citizen or a PR from your third year, aged 55 or below, 20 % of your ordinary wages goes to CPF, up to ${formatMoney(T['55_below'].max_employee)} a month because contributions stop at the ${formatMoney(P.cpf.ow_ceiling_month)} ceiling. Your employer adds 17 % on top. The share falls with age, to 18 % above 55, 12.5 % above 60 and 5 % above 70, and it is much lower for PRs in their first two years.` },
  { q: 'Is income tax deducted from my monthly salary in Singapore?', a: 'No. Singapore has no pay-as-you-earn withholding for most employees. Your payslip only deducts your CPF share; income tax is assessed once a year by IRAS on the previous year’s income and paid in one go or by GIRO in up to 12 instalments. That is why this calculator shows a monthly amount to set aside rather than a monthly tax deduction.' },
  { q: 'Why is my take-home pay lower than my salary minus 20 %?', a: 'Usually because of self-help group contributions such as CDAC, MBMF, SINDA or ECF, which employers deduct for citizens and PRs by default, or unpaid leave, or a deduction agreed in writing. The calculator does not include self-help group fund amounts, which range from a few dollars to about $30 a month depending on the fund and your wage.' },
  { q: 'Do foreigners on an Employment Pass pay CPF?', a: 'No. CPF is compulsory only for Singapore Citizens and Singapore Permanent Residents. Employment Pass, S Pass and Work Permit holders keep their whole salary each month and pay only income tax. Their employer still pays the Skills Development Levy, between $2 and $11.25 a month per employee, and a foreign worker levy for S Pass and Work Permit holders.' },
  { q: 'When does the $8,000 CPF ceiling matter?', a: `Once your ordinary wages go above ${formatMoney(P.cpf.ow_ceiling_month)} a month, no CPF is due on the excess, so your contribution stays at ${formatMoney(T['55_below'].max_employee)} and your employer’s at ${formatMoney(T['55_below'].max_total - T['55_below'].max_employee)}. Your bonus can still attract CPF up to the Additional Wage ceiling, which is ${formatMoney(P.cpf.annual_salary_ceiling)} minus the ordinary wages already subject to CPF in the year.` },
  { q: 'Which year of assessment does this calculator use?', a: `Income earned in ${YEAR} is taxed in the Year of Assessment ${YEAR + 1}. The calculator applies the resident rates in force since YA 2024, from 0 % on the first $20,000 of chargeable income to 24 % above $1 million. Budget ${YEAR} announced no personal income tax rebate for YA ${YEAR}, so none is assumed for YA ${YEAR + 1} until the government says otherwise.` },
  { q: 'Does this calculator send my salary anywhere?', a: 'No. Every figure is computed by your browser from the CPF and IRAS tables embedded in the page. Nothing you type is stored, sent to a server or linked to you. If you use the share link, your inputs travel in the address itself, and only to the people you choose to send that link to.' },
];
const related = ['cpf', 'employerCpf', 'afterTax', 'incomeTax', 'netToGross', 'hourly', 'bonus', 'cpfRates', 'sprRates'].map((id) => ({ href: route(id, lang), name: label(id), description: '' }));
const sources = [
  { name: 'CPF Board: CPF Contribution Rate Tables from 1 January 2026', url: P.sources.cpf_rates.url },
  { name: 'CPF Board: CPF Allocation Rates from 1 January 2026', url: P.sources.cpf_alloc.url },
  { name: 'IRAS: Individual Income Tax rates', url: P.sources.iras_rates.url },
  { name: 'IRAS: CPF Relief for employees', url: P.sources.iras_cpf_relief.url },
  { name: 'CPF Board: Contribution changes from 1 January 2027', url: P.sources.cpf_2027.url },
];
const jsonLd = [webApplicationSchema({ name: `Salary Calculator Singapore ${YEAR}`, description, path: route('home', lang), lang }), faqSchema(faqs, lang), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }]), organizationSchema(lang), personSchema(lang), websiteSchema(lang)];
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Singapore salary calculator {YEAR}: CPF, income tax and take-home pay</h1>
    <p class="mt-3 text-lg text-navy-600">Enter your monthly salary, your age and your status. You get your take-home pay, your CPF and your employer’s, how the contributions split between your Ordinary, Special or Retirement and MediSave accounts, and the income tax IRAS will assess for YA {YEAR + 1}. It uses all five CPF rate tables, so first- and second-year PRs get their real graduated rates.</p>
    <p class="mt-3"><span class="inline-block rounded-full border border-navy-200 bg-white px-3 py-1 text-xs font-medium text-navy-600">CPF Board rates from 1 January {YEAR} · IRAS resident rates · checked on <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, __LT[lang])}</time> by {AUTHOR_NAME}</span></p>
  </header>
  <SgCalculator client:load mode="salary" methodHref={route('method', lang)} />
  <AdSlot slot="home-1" />
  <section class="prose prose-slate max-w-none">
    <h2 id="short-answer">What you take home on {formatMoney(5000)} a month</h2>
    <p>A Singapore Citizen aged 30 earning {formatMoney(5000)} a month takes home {formatMoney(e5.takeHomeMonthly)}. The only deduction on the payslip is the employee CPF contribution of 20 %, {formatMoney(e5.monthly.employee)}, while the employer pays another {formatMoney(e5.monthly.employer)} into the same CPF accounts, which brings the total to {formatMoney(e5.monthly.total)} a month. Income tax is not withheld: IRAS sends a bill the following year, and on {formatMoney(60000)} of annual salary it comes to {formatMoney(e5.annual.tax)} after the earned income relief and the CPF relief, about {formatMoney(e5.annual.tax / 12)} a month to set aside. Net of CPF and tax, that is {formatMoney(e5.annual.net)} a year. The same salary gives a first-year PR {formatMoney(pr1.takeHomeMonthly)} a month, because graduated rates take only 5 % from the employee, and an Employment Pass holder the full {formatMoney(fo.takeHomeMonthly)}, because foreigners do not contribute to CPF at all.</p>

    <h2 id="how">How the calculation works</h2>
    <p>Singapore payroll has one particularity that trips up most people moving here: the monthly payslip and the annual tax bill are two separate systems. The payslip follows the CPF Act; the tax bill follows the Income Tax Act and arrives months later. The calculator runs both, in this order.</p>
    <ol>
      <li><strong>Ordinary wages.</strong> Your basic salary and the allowances paid for the month. CPF is due on ordinary wages up to {formatMoney(P.cpf.ow_ceiling_month)} a month; anything above is free of CPF.</li>
      <li><strong>The right rate table.</strong> The CPF Board publishes five tables for {YEAR}: one for citizens and PRs from their third year, and four for PRs in their first and second year, depending on whether the employer and employee chose graduated or full rates. Each table has five age bands.</li>
      <li><strong>The wage band.</strong> Below $50 a month nothing is due. Between $50 and $500 only the employer pays. Between $500 and $750 the employee share phases in. Above $750 the full percentages apply.</li>
      <li><strong>The rounding rules.</strong> The total contribution is rounded to the nearest dollar, the employee share is rounded down, and the employer pays the difference. That is why the employee share of {formatMoney(4999)} is {formatMoney(cpf(4999).employee)} and not {formatMoney(999.8, 2)}.</li>
      <li><strong>Allocation.</strong> Each contribution is split, MediSave first, then the Special Account (or the Retirement Account from 55), and the remainder goes to the Ordinary Account.</li>
      <li><strong>Additional wages.</strong> A bonus or 13th month counts as additional wages. CPF applies to it up to the Additional Wage ceiling: {formatMoney(P.cpf.annual_salary_ceiling)} minus the ordinary wages already subject to CPF during the year.</li>
      <li><strong>Income tax.</strong> Annual salary and bonus, minus the earned income relief ({formatMoney(1000)} below 55), minus your compulsory employee CPF, minus any other reliefs you enter, capped at {formatMoney(P.tax.relief_cap)} in total. The result is taxed at the resident rates for YA {YEAR + 1}.</li>
    </ol>

    <h2 id="five-tables">Why five CPF tables change everything for a new PR</h2>
    <p>Most salary calculators in Singapore apply one set of rates: 20 % from the employee and 17 % from the employer. That is right for citizens, and for permanent residents from their third year. It is wrong for everyone else, and the difference is large. The table below shows one salary of {formatMoney(5000)} at age 30 under each of the six situations the calculator knows.</p>
    <ContentTable headers={['Status', 'Employee CPF', 'Employer CPF', 'Take-home']} align={['l', 'r', 'r', 'r']} rows={statusRows} />
    <p>A PR in the first year of their status contributes {formatMoney(cpf(5000, 30, 'SPR1_GG').employee)} instead of {formatMoney(cpf(5000, 30, 'SC').employee)}, and takes home {formatMoney(pr1.takeHomeMonthly - e5.takeHomeMonthly)} more each month. In the second year the employee share rises to 15 %. From the third year, the full rates apply automatically. The graduated rates exist so that new PRs are not locked into CPF savings they may never use if they leave, but they can be waived: the employer and employee may jointly apply to the CPF Board to pay full rates, either both at full rates (table 1) or the employer at full rates and the employee at graduated rates (tables 4 and 5). Our <a href={route('sprRates', lang)}>guide to SPR graduated rates</a> sets out the tables and when opting in makes sense.</p>
    <p>Age is the second multiplier. The same {formatMoney(5000)} salary at 58 costs the employee {formatMoney(e58.monthly.employee)} instead of {formatMoney(e5.monthly.employee)}, because the rate drops from 20 % to 18 % above 55. From 1 January 2027, the rates for employees above 55 and up to 65 rise again, by 1.5 and 1 percentage points; select “2027” in the calculator to see the new figures, or read <a href={route('cpf2027', lang)}>what changes in 2027</a>.</p>

    <h2 id="accounts">Where your CPF money goes</h2>
    <p>The total contribution is not one pot. The CPF Board splits it into three accounts with different uses: the Ordinary Account for housing, insurance and investment; the Special Account for retirement, which closed on your 55th birthday since 2025 and is replaced by the Retirement Account; and MediSave for healthcare. The split depends on age only. At 30, {formatDecimal(P.cpf.allocation['35_below'].oa * 100)} % of every dollar goes to the Ordinary Account; above 60, only {formatDecimal(P.cpf.allocation['60_65'].oa * 100)} % does and MediSave takes {formatDecimal(P.cpf.allocation['60_65'].ma * 100)} %. On {formatMoney(5000)} a month at 30, a year of contributions puts {formatMoney(e5.allocation.oa)} in your Ordinary Account, {formatMoney(e5.allocation.sa)} in your Special Account and {formatMoney(e5.allocation.ma)} in MediSave. The <a href={route('allocation', lang)}>allocation rates page</a> gives the full grid.</p>

    <h2 id="parameters">CPF and tax parameters for {YEAR}</h2>
    <ContentTable headers={['Parameter', 'Value']} align={['l', 'r']} rows={[
      ['Ordinary wage ceiling', `${formatMoney(P.cpf.ow_ceiling_month)} a month`],
      ['Annual salary ceiling (for the AW ceiling)', formatMoney(P.cpf.annual_salary_ceiling)],
      ['Total CPF, 55 and below', formatPercent(T['55_below'].total, 0)],
      ['Employee share, 55 and below', formatPercent(T['55_below'].employee, 0)],
      ['Total CPF, above 55 to 60', formatPercent(T['55_60'].total, 0)],
      ['Total CPF, above 60 to 65', formatPercent(T['60_65'].total, 0)],
      ['Total CPF, above 65 to 70', formatPercent(T['65_70'].total, 1)],
      ['Total CPF, above 70', formatPercent(T['70_above'].total, 1)],
      ['Skills Development Levy (employer)', `0.25 %, ${formatMoney(P.sdl.min, 2)} to ${formatMoney(P.sdl.max, 2)} a month`],
      ['Top resident tax rate', formatPercent(0.24, 0)],
      ['Personal relief cap', formatMoney(P.tax.relief_cap)],
      ['Non-resident employment income', 'higher of 15 % and resident rates'],
    ]} />

    <h2 id="examples">Worked examples: citizen aged 30, no bonus</h2>
    <ContentTable headers={['Monthly salary', 'Employee CPF', 'Take-home', 'Employer CPF', 'Tax YA 2027', 'Net per month after tax']} align={['r', 'r', 'r', 'r', 'r', 'r']} rows={rows} />
    <p>Two things stand out. First, take-home pay grows by 80 cents on every extra dollar up to {formatMoney(P.cpf.ow_ceiling_month)}, then by a full dollar, because CPF stops at the ceiling. Second, tax stays light for most employees: at {formatMoney(10000)} a month, the YA {YEAR + 1} bill is {formatMoney(e10.annual.tax)}, an effective rate of {formatPercent(e10.annual.effectiveTaxRate)} on gross salary. Singapore’s progressive scale only bites hard above {formatMoney(160000)} of chargeable income.</p>

    <AdSlot slot="home-2" />

    <h2 id="popular">Popular salary examples</h2>
    <p>Each page below starts from one salary and explains the threshold that makes it different: the Local Qualifying Salary at {formatMoney(1800)}, the median wage, the {formatMoney(8000)} ceiling, the point where tax starts to matter.</p>
    <ul class="columns-2 sm:columns-3" data-chrome>
      {MONTHLY.map((a) => <li><a href={route(`m-${a}`, lang)}>{monthlyLabel(a)}</a></li>)}
      {ANNUAL.map((a) => <li><a href={route(`y-${a}`, lang)}>{annualLabel(a)}</a></li>)}
      {HOURLY.map((a) => <li><a href={route(`h-${a}`, lang)}>{hourlyLabel(a)}</a></li>)}
    </ul>

    <h2 id="tips">Six ways to keep more of the same salary</h2>
    <ol>
      <li><strong>Claim the reliefs you are entitled to.</strong> The CPF relief and the earned income relief are applied automatically, but spouse, child, working mother’s child, parent and NSman reliefs are not all pre-filled. Each one lowers your chargeable income, up to the {formatMoney(P.tax.relief_cap)} cap.</li>
      <li><strong>Top up your own Special or Retirement Account in cash.</strong> Up to $8,000 a year is deductible, and another $8,000 for top-ups to family members. At a 7 % marginal rate that saves {formatMoney(560)} of tax.</li>
      <li><strong>Consider the Supplementary Retirement Scheme.</strong> Contributions up to $15,300 a year for citizens and PRs are deductible; half of withdrawals after the statutory retirement age are taxed.</li>
      <li><strong>Check the timing of your bonus.</strong> A bonus is taxed in the year it is paid, and CPF on it is capped by the Additional Wage ceiling. The <a href={route('bonus', lang)}>bonus calculator</a> shows what part of it you keep.</li>
      <li><strong>For new PRs, weigh the full-rate option.</strong> Opting into full rates lowers take-home pay today but brings the employer’s full 17 % into your accounts. It is often worth it for people who plan to buy an HDB flat.</li>
      <li><strong>Pay tax by GIRO.</strong> It costs nothing and spreads the bill over up to 12 months, which matches the monthly amount the calculator tells you to set aside.</li>
    </ol>

    <h2 id="limits">What the calculator does not do</h2>
    <p>It does not deduct self-help group contributions, because they depend on your race and religion and you can opt out. It does not apply the Workfare Income Supplement, a separate government payment for lower-wage workers. It treats the bonus as paid in December, and assumes your salary is the same every month; if it changes during the year, the Additional Wage ceiling changes too. It assumes tax residency for citizens and PRs. For self-employed income, MediSave is computed differently: see <a href={route('selfEmployed', lang)}>CPF for the self-employed</a>. The <a href={route('method', lang)}>methodology page</a> lists every rule and test.</p>
    <Sources lang={lang} />
  </section>
</PageLayout>
