---
import AmountPage from '../../components/AmountPage.astro';
import { route, HOURLY } from '../../i18n/routes';
import { hourlyLabel } from '../../i18n/nav';
import { hourlyAngle } from '../../lib/amount-angles';
import { monthlyFromHourly } from '../../lib/engine/sg';
import { ex } from '../../lib/tables';
import { SRC } from '../../lib/sources';
import { formatMoney } from '../../lib/format';
export function getStaticPaths() { return HOURLY.map((a) => ({ params: { rate: String(a) } })); }
const rate = Number(Astro.params.rate); const m = monthlyFromHourly(rate);
const rows = [8, 10, 20, 30, 44].map((h) => { const mm = m * h / 44; const r = ex(mm); return [`${h} h a week`, formatMoney(mm), formatMoney(r.monthly.employee), formatMoney(r.takeHomeMonthly), formatMoney(r.monthly.employer)]; });
const near = HOURLY.filter((h) => h !== rate);
---
<AmountPage id={`h-${rate}`} crumb={hourlyLabel(rate)} angle={hourlyAngle(rate)} monthly={m} hourly={rate} mode="hourly"
  table={{ caption: `${formatMoney(rate, 2)} an hour by weekly hours`, headers: ['Hours', 'Monthly pay', 'Employee CPF', 'Take-home', 'Employer CPF'], rows }}
  neighbours={[...near.map((n) => ({ href: route(`h-${n}`, 'en'), name: hourlyLabel(n) })), { href: route('hourly', 'en'), name: 'Hourly to salary calculator' }, { href: route('minimumWage', 'en'), name: 'Minimum wage and LQS' }]}
  sources={[SRC.mom_hourly, SRC.cpf_rates, SRC.iras_rates]} />
