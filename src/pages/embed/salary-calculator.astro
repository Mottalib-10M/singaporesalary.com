---
/** Page embarquable (iframe) : calculateur nu, lien de crédit visible (RECETTE §13). */
import '../../styles/global.css';
import SgCalculator from '../../components/calc/SgCalculator';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Singapore salary and CPF calculator, widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <SgCalculator client:load />
    <p class="mt-2 text-center text-xs text-navy-500"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="hover:underline">singaporesalary.com</a> · CPF and tax calculated in your browser</p>
  </body>
</html>
